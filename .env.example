# Copie para .env (o instalar faz isso sozinho) e preencha. Nunca mande este arquivo para ninguem.

# OpenAI: escreve as pautas, os carrosseis e os roteiros dos Reels.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Preco por milhao de tokens do modelo acima, para o teto mensal.
OPENAI_PRICE_PER_MTOK={"input":0.25,"output":2}
OPENAI_MONTHLY_BUDGET_USD=5

# Instagram DA GUIDE que publica (API do Instagram com login do Instagram), com a permissao
# instagram_business_content_publish.
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Senha do painel (http://127.0.0.1:3200). O instalar gera uma.
PANEL_PASSWORD=
# Assina os enderecos dos arquivos que a Meta baixa. O instalar gera.
STATE_ENCRYPTION_KEY=

# Contas do Gemini (cada uma abre o seu Chrome: conta 1 na porta 9236, conta 2 na 9237).
# Quando uma bate o limite do dia ou sai da conta, o sistema passa para a outra.
GEMINI_ACCOUNTS=2

# Opcionais
# PORT=3200
# TIME_ZONE=America/Sao_Paulo
# GEMINI_CDP_URL=http://127.0.0.1:9236
# CONTENT_DIR=./content
# Endereco publico de onde a Meta baixa os arquivos. Vazio: o tunel do LIGAR-CONTEUDO (tunel-url.txt).
# CONTENT_PUBLIC_BASE_URL=
# FFMPEG_PATH=
# WEB_BROWSER_PATH=
